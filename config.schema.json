{
  "pluginAlias": "LevitonDecoraSmart",
  "pluginType": "platform",
  "singular": false,
  "schema": {
    "type": "object",
    "properties": {
      "email": {
        "title": "email",
        "type": "string",
        "required": true,
        "x-schema-form": {
          "type": "username"
        }
      },
      "password": {
        "title": "password",
        "type": "string",
        "required": true,
        "x-schema-form": {
          "type": "password"
        }
      },
      "loglevel": {
        "title": "Log Level",
        "type": "string",
        "default": "info",
        "oneOf": [
          { "title": "Debug", "enum": ["debug"] },
          { "title": "Info", "enum": ["info"] },
          { "title": "Warn", "enum": ["warn"] },
          { "title": "Error", "enum": ["error"] }
        ],
        "description": "Set logging verbosity level"
      },
      "excludedModels": {
        "type": "array",
        "description": "List of models to be excluded",
        "items": {
          "type": "string"
        }
      },
      "excludedSerials": {
        "type": "array",
        "description": "List of serial numbers to be excluded",
        "items": {
          "type": "string"
        }
      },
      "structuredLogs": {
        "title": "Enable Structured Logging",
        "type": "boolean",
        "default": false,
        "description": "Enable machine-parseable JSON logging for better log aggregation"
      }
    }
  }
}
